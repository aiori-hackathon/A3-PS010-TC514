# Copy this file to .env and adjust. NEVER commit .env.
# Blank values mean "use the default / not configured".

# ---- Storage ---------------------------------------------------------------
# SQLite audit history file. Created only when auditing is enabled and a record is
# saved; never created or written otherwise. It is git-ignored; keep it out of backups you share.
NETCLASS_DB_PATH=data/audit.sqlite3

# ---- Audit history (OFF by default) -----------------------------------------
# Leave blank (or false) and nothing is ever written. Set to true to save every classification
# made through the service / classify_ip.py to the SQLite file above, or pass --audit per run
# (--no-audit overrides this setting). Accepts true/false/yes/no/on/off/1/0.
# PRIVACY: the file stores the IP addresses you classify, the observation times, the labels and
# the evidence records. It never stores API tokens, authorization headers or raw HTTP bodies.
NETCLASS_AUDIT_ENABLED=
# Records older than this many days are deleted ONLY when you run
#   python scripts\audit_history.py purge --yes
# (without --yes it is a dry run). Nothing is purged automatically, on start-up or on open.
# 0 = keep records indefinitely: set it only deliberately, because IP addresses can be
# personal data and an unbounded history grows and stays on disk until you delete it yourself.
NETCLASS_AUDIT_RETENTION_DAYS=90
# Downloaded snapshots are retained here (safe to delete; re-downloaded on demand)
NETCLASS_CACHE_DIR=data/cache

# ---- Evidence sources ------------------------------------------------------
# Comma-separated subset of: tor-project-bulk-exit-list, x4bnet-lists-vpn, az0-vpn-ip
# (default: all three). A disabled source is simply not consulted.
NETCLASS_ENABLED_SOURCES=

# Tor exit list endpoint (default shown)
NETCLASS_TOR_EXIT_LIST_URL=https://check.torproject.org/torbulkexitlist

# ---- Networking and freshness ----------------------------------------------
# Connect/read timeout per request, in seconds
NETCLASS_HTTP_TIMEOUT_SECONDS=10

# Retries after the first attempt for the three evidence sources (0-2, default 2). Only
# timeouts, connection errors, HTTP 429 and HTTP 5xx are retried; Retry-After is honoured.
NETCLASS_HTTP_MAX_RETRIES=2
# Refuse downloads larger than this many bytes
NETCLASS_MAX_DOWNLOAD_BYTES=20000000
# A cached snapshot is reused for this many seconds, then re-downloaded. An older
# snapshot is never used as evidence, even if the re-download fails.
NETCLASS_CACHE_TTL_SECONDS=1800
# A current-only snapshot supports an observation only within this many seconds
# of its retrieval time. Must be >= the cache TTL.
NETCLASS_CURRENT_EVIDENCE_TOLERANCE_SECONDS=3600
# Reject a source whose own Last-Modified header is older than this (when present)
NETCLASS_MAX_SOURCE_AGE_SECONDS=86400

# ---- Network context (RIPEstat; context only, never evidence) ---------------
NETCLASS_RIPESTAT_BASE_URL=https://stat.ripe.net/data
# Optional identifier sent as RIPEstat's "sourceapp" parameter (letters, digits, - and _).
# RIPEstat asks regular users (>1000 requests/day) to register one. Not a secret.
NETCLASS_RIPESTAT_SOURCEAPP=
# Successful RIPEstat answers are reused for this many seconds (in memory only).
NETCLASS_RIPESTAT_CACHE_TTL_SECONDS=3600

# ---- Optional IPinfo Lite metadata (supplementary only, never evidence) -----
# Leave IPINFO_TOKEN blank to keep IPinfo DISABLED (the default): no request is ever made
# and everything else works exactly the same. To ENABLE it, paste your own IPinfo API token
# (from your IPinfo dashboard) after the "=" and request metadata explicitly, for example
#   python scripts\classify_ip.py 8.8.8.8 --ipinfo
# To DISABLE it again, blank the value or delete the line.
# The token is a secret: keep it only in .env (ignored by Git), never in code, tests or logs.
# When used, the queried public IP address is sent to IPinfo (a third party); private,
# reserved and loopback addresses are never sent. IPinfo data never changes the label.
# Plan limits are IPinfo's: see https://ipinfo.io/developers and your IPinfo account.
IPINFO_TOKEN=
# Base URL of the IPinfo API (must be https; default https://api.ipinfo.io). Normally leave blank.
NETCLASS_IPINFO_BASE_URL=
# Successful IPinfo answers are reused for this many seconds (in memory only; default 3600).
NETCLASS_IPINFO_CACHE_TTL_SECONDS=

# ---- Reserved --------------------------------------------------------------
# Optional commercial VPN/proxy provider; the hackathon sources need no key.
NETCLASS_VPN_PROVIDER=
NETCLASS_VPN_API_KEY=
